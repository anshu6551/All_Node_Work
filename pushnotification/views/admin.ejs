<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 40px; background: #f4f6f9; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 0 auto; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button { background: #2ecc71; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px; }
        button:hover { background: #27ae60; }
        .status { margin-top: 15px; text-align: center; font-weight: bold; }
    </style>
</head>
<body>

    <div class="card">
        <h2>Admin Panel</h2>
        <h3>Add New Product</h3>
        
        <form id="productForm" enctype="multipart/form-data">
            <div class="form-group">
                <label for="pName">Product Name</label>
                <input type="text" name="name" id="pName" placeholder="e.g., Wireless Mouse" required>
            </div>
            <div class="form-group">
                <label for="pPrice">Price ($)</label>
                <!-- Added step="0.01" to safely support decimal entries like 10.99 -->
                <input type="number" name="price" id="pPrice" step="0.01" placeholder="e.g., 25.00" required>
            </div>
            <div class="form-group">
                <label for="pImage">Product Image</label>
                <input type="file" name="productImage" id="pImage" accept="image/*" required>
            </div>
            <button type="submit">Publish Product</button>
        </form>

        <div id="statusMsg" class="status"></div>
    </div>

    <script>
        const form = document.getElementById('productForm');
        const statusMsg = document.getElementById('statusMsg');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            
            // UI Hint: Visual loader feedback indicator
            statusMsg.style.color = "#3498db";
            statusMsg.textContent = "Uploading product data...";

            try {
                const response = await fetch('/admin/add-product', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`HTTP network error! Status: ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    form.reset();
                    statusMsg.style.color = "#2ecc71"; // Dynamic green success color
                    statusMsg.textContent = "Product published & notifications broadcast!";
                } else {
                    // Triggers if server returned 200 OK but success parameter evaluates false
                    statusMsg.style.color = "#e74c3c";
                    statusMsg.textContent = result.message || "Failed to add product.";
                }
            } catch (error) {
                // Catches offline states, server timeouts, or script failures
                console.error("Submission error details:", error);
                statusMsg.style.color = "#e74c3c"; // Dynamic red failure color
                statusMsg.textContent = "Network error. Could not connect to the server.";
            } finally {
                // Automatically clears the status block after 4 seconds regardless of outcome
                setTimeout(() => { statusMsg.textContent = ""; }, 4000);
            }
        });
    </script>
</body>
</html>