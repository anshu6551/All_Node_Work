<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <h1 class="text-center mt-3">Products Page</h1>

    <div class="container my-4">

        <div class="row row-cols-1 row-cols-md-3 g-4">

            <% products.forEach(function(p){ %>   <!-- here we use foreeach loop to iterate products array and access each product object using p variable, then we can use p to access product properties like p.name, p.price etc. and display them in the card layout.-->

                <div class="col">

                    <div class="card h-100 text-center  bg-dark text-white">


                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <%= p.name %>
                            </h5>
                        </div>

                        <div class="card-body">

                            <p class="card-text">
                                <%= p.desc %>
                            </p>

                            <p class="card-text">
                                <strong>Price:</strong> ₹<%= p.price %>
                            </p>

                            <!-- <p class="card-text">
                <strong>Size:</strong>
                <%= p.size && p.size.length ? p.size.join(", ") : "N/A" %>   <!-- check size exist and it is not empty array, if true combine array item into a string, if false show N/A -->
            </p>

            <p class="card-text">
                <strong>Color:</strong>
                <%= p.color && p.color.length ? p.color.join(", ") : "N/A" %>
            </p> 


                            <p class="card-text">
                                <strong>Size:</strong>
                                <% if (p.size && p.size.length> 0) { %>   <!-- check size exist and it is  not empty array -->
                                    <%= p.size.join(", ") %>             <!-- combine array item into a string -->
                                         <% } else { %>                   
                                            N/A
                                    <% } %>
</p>

<p class=" card-text">
                                        <strong>Color:</strong>
                                        <% if (p.color && p.color.length> 0) { %>
                                            <%= p.color.join(", ") %>
                                               <% } else { %>
                                                   N/A
                                              <% } %>
</p>

            <p class=" card-text">
                                                <strong>Category:</strong>
                                                <%= p.category %>
                            </p>

                            <p class="card-text">
                                <strong>Rating:</strong> ⭐ <%= p.rating %> 
                            </p>

                        </div>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>

    <div class="text-center mb-4">
        <a href="/">Go to Home</a>
    </div>

</body>

</html>