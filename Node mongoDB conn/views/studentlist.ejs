<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Student List</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>

<body>

<div class="container mt-4">

  <h2>Student List</h2>

  <a href="/student/add" class="btn btn-primary mb-3">Add Student</a>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>City</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% data.forEach((student, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= student.name %></td>
          <td><%= student.email %></td>
          <td><%= student.phone %></td>
          <td><%= student.city %></td>
          <td>

            <a href="/student/edit/<%= student._id %>" class="btn btn-warning btn-sm">Edit</a>

            <a href="/student/delete/<%= student._id %>" 
               class="btn btn-danger btn-sm"
               onclick="return confirm('Are you sure?')">
              Delete
            </a>

          </td>
        </tr>
      <% }) %>
    </tbody>

  </table>

</div>

</body>
</html>