<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Edit Student</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>

<body>

<div class="container mt-4">

  <h2>Edit Student</h2>

  <!-- IMPORTANT: must match router.post('/student/update/:id') -->
  <form action="/student/update/<%= data._id %>" method="POST">

    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="<%= data.name %>" class="form-control" required>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" 
      value="<%= data.email %>" class="form-control" required>
    </div>

    <div class="form-group">
      <label>Phone</label>
      <input type="number" name="phone" value="<%= data.phone %>" class="form-control" required>
    </div>

    <div class="form-group">
      <label>City</label>
      <input type="text" name="city" value="<%= data.city %>" class="form-control" required>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a href="/student/studentlist" class="btn btn-secondary">Back</a>

  </form>

</div>

</body>
</html>